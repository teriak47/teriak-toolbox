{
  "name": "graphax",
  "version": "0.2.0",
  "private": true,
  "description": "Tableau d'enquête et graphe d'analyse interactif local (SurrealDB Embedded + React Flow)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "node --watch-path=server --watch-path=shared server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@surrealdb/node": "^3.1.0",
    "@surrealdb/node-native": "^3.3.5",
    "clsx": "^2.1.1",
    "hono": "^4.13.14",
    "lucide-react": "^1.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "surrealdb": "^2.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
