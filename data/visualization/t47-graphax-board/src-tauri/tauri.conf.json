{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graphax",
  "version": "../package.json",
  "identifier": "com.teriak47.graphax",
  "build": {
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "..", "wait": false },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": { "script": "pnpm build", "cwd": ".." },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Graphax",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
